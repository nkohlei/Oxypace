{
  "name": "oxypace-desktop",
  "version": "1.1.6",
  "description": "Oxypace Desktop Application",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "build": "electron-packager . Oxypace --platform=win32 --arch=x64 --out=dist-build --icon=../client/public/logo.ico --overwrite"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-packager": "^17.1.2"
  },
  "build": {
    "appId": "com.oxypace.desktop",
    "productName": "Oxypace",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "../client/public/logo.ico"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "client-dist/**/*"
    ]
  }
}
