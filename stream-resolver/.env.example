# ─── Ortam Değişkenleri ───────────────────────────────────────────────────────

# Sunucu portu (varsayılan: 3001)
PORT=3001

# Log seviyesi: error | warn | info | debug
LOG_LEVEL=info

# Varsayılan Playwright timeout (ms)
DEFAULT_TIMEOUT=30000

# İzin verilen CORS origin'leri (virgülle ayrılmış)
ALLOWED_ORIGINS=https://oxypace.com,https://www.oxypace.com,http://localhost:3000

# IP başına dakikada maksimum istek sayısı
RATE_LIMIT_MAX=60

# ─── ⚡ Performans & Eşzamanlılık (Concurrency) Ayarları ──────────────────────

# Aynı anda çalıştırılabilecek maksimum Chromium oturumu (RAM/CPU koruması)
MAX_CONCURRENT_RESOLVES=6

# Önbellek süresi (ms) — Varsayılan: 15 dakika (900000 ms)
CACHE_TTL_MS=900000

# Önbellekte saklanacak maksimum link sayısı
CACHE_MAX_ITEMS=1000

# ─── 🛡️ Production & Cloudflare / IP Koruma Ayarları ─────────────────────────

# 1. Residential / Datacenter Proxy Ayarı (Cloudflare & IP engellerini aşmak için)
# Örnek: http://p.webshare.io:80 veya http://185.123.45.67:8080 veya socks5://...
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=

# 2. API Güvenlik Anahtarı (Yetkisiz kullanımları önlemek için isteğe bağlı)
API_SECRET_KEY=
